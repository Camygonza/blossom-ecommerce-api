# Copia este archivo a ".env" (no se versiona) y cambia los valores:  cp env.ejemplo .env
# Contraseña de PostgreSQL
DB_PASSWORD=cambia-esta-contrasena
# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-al-menos-32-caracteres
# Opcionales
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# LOGIN_RATE_LIMIT_MAX=10
